{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' blob:; connect-src 'self' https://feeds.behold.so; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests" }
      ]
    },
    {
      "source": "/((?:(?:index|about|contact|cultivation|disclaimer|export-partners|news|origins|privacy|products|quality|social-impact|team|terms|tohu|whats-new)|news/(?:innovation-extraction|kaitiakitanga-land-wellness|sustainable-sun-grown))(?:\\.html)?|)",
      "headers": [
        {"key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://js-ap1.hs-scripts.com https://js-ap1.hs-analytics.net https://js-ap1.hs-banner.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' blob:; connect-src 'self' https://feeds.behold.so https://www.googletagmanager.com https://www.google-analytics.com https://region1.google-analytics.com https://www.google.com https://track-ap1.hubspot.com https://track.hubspot.com https://js-ap1.hs-banner.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests"}
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/:route*", "destination": "/api/index?route=:route*" },
    { "source": "/r/:code", "destination": "/api/index?route=referral/go&code=:code" }
  ],
  "redirects": [
    { "source": "/portal/:id(prescriber|pharmacy|export-partner)", "destination": "/portal/:id/home", "permanent": false },
    { "source": "/prescribers-portal", "destination": "/portal/prescriber/login", "permanent": true },
    { "source": "/pharmacies-portal", "destination": "/portal/pharmacy/login", "permanent": true },
    { "source": "/export-portal", "destination": "/portal/export-partner/login", "permanent": true },
    { "source": "/product", "destination": "/products", "permanent": true },
    { "source": "/community", "destination": "/social-impact", "permanent": true },
    { "source": "/partner", "destination": "/export-partners", "permanent": true },
    { "source": "/blog", "destination": "/news", "permanent": true },
    { "source": "/blog/medicinal-cannabis-nz", "destination": "/news/medicinal-cannabis-nz", "permanent": true },
    { "source": "/blog/kaitiakitanga-land-wellness", "destination": "/news/kaitiakitanga-land-wellness", "permanent": true },
    { "source": "/blog/sustainable-sun-grown", "destination": "/news/sustainable-sun-grown", "permanent": true },
    { "source": "/blog/innovation-extraction", "destination": "/news/innovation-extraction", "permanent": true }
  ]
}
